{
  "name": "@taskproof/grader",
  "version": "0.1.0",
  "description": "Deterministic assertion engine for taskproof: evaluates url/dom/network assertions against a run and aggregates pass@k",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskproof/core": "workspace:^",
    "@taskproof/spec": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
