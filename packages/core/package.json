{
  "name": "@taskproof/core",
  "version": "0.1.0",
  "description": "Shared contract for taskproof runner adapters: the run-artifact schema, the adapter interface, and the token/cost meter",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskproof/spec": "workspace:^",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
