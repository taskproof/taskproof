{
  "name": "@taskproof/judge",
  "version": "0.1.0",
  "description": "Optional LLM judge (WebJudge-style) for taskproof: a versioned rubric prompt that grades goal completion from a run's evidence, gated behind the deterministic assertions",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@taskproof/core": "workspace:^",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
