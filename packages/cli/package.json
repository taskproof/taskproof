{
  "name": "taskproof",
  "version": "0.2.1",
  "description": "CLI for running a matrix of real AI agents through task specs against your site",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taskproof/taskproof.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/taskproof/taskproof#readme",
  "bugs": "https://github.com/taskproof/taskproof/issues",
  "keywords": [
    "ai-agents",
    "agent-testing",
    "playwright",
    "llm",
    "computer-use",
    "browser-use",
    "ci",
    "evals",
    "web-testing"
  ],
  "type": "module",
  "bin": {
    "taskproof": "./dist/index.js"
  },
  "main": "./dist/program.js",
  "types": "./dist/program.d.ts",
  "exports": {
    ".": {
      "types": "./dist/program.d.ts",
      "default": "./dist/program.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@taskproof/adapter-browser-use": "workspace:^",
    "@taskproof/adapter-claude": "workspace:^",
    "@taskproof/core": "workspace:^",
    "@taskproof/grader": "workspace:^",
    "@taskproof/judge": "workspace:^",
    "@taskproof/report": "workspace:^",
    "@taskproof/spec": "workspace:^",
    "commander": "^14.0.0",
    "jimp": "^1.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
