{
  "name": "@taskproof/spec",
  "version": "0.1.0",
  "description": "The taskproof task-spec format: versioned YAML schema with Zod validation for agent-usability tasks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
