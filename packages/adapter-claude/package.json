{
  "name": "@taskproof/adapter-claude",
  "version": "0.2.0",
  "description": "Claude computer-use runner adapter: drives Playwright-managed Chromium and emits taskproof artifacts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@taskproof/core": "workspace:^",
    "@taskproof/grader": "workspace:^",
    "@taskproof/spec": "workspace:^",
    "playwright": "^1.60.0"
  },
  "engines": {
    "node": ">=22"
  }
}
